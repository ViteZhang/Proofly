# Supabase — client-safe keys only. Never put the service role key here or in the app.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 模型接入（Step 2 起）——服务端专用，不带 NEXT_PUBLIC_ 前缀，不会进客户端 bundle。
# OpenAI 兼容协议。走中转 API 时把 BASE_URL 换成中转地址即可，代码不用改。
# 具体型号写在 src/lib/llm/config.ts，换接入点前先 GET /v1/models 看清单。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# 向量档可以走另一个接入点：中转站通常只转发对话模型，向量得单独接。
# 不填则回落到上面的 OPENAI_*。当前用的是阿里云百炼的
# qwen3.7-text-embedding，传 dimensions=1536 正好对上表结构。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 兜底档：主接入点挂了（连不上/超时/5xx/限流）时整条请求换到这里重发。
# 型号写在 src/lib/llm/config.ts 的 FALLBACK_MODEL，不在这里配。
# 不填就是没有兜底，行为跟以前一样。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
