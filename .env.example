# Supabase — client-safe keys only. Never put the service role key here or in the app.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 模型接入（Step 2 起）——服务端专用，不带 NEXT_PUBLIC_ 前缀，不会进客户端 bundle。
# OpenAI 兼容协议。走中转 API 时把 BASE_URL 换成中转地址即可，代码不用改。
# 具体型号写在 src/lib/llm/config.ts，换接入点前先 GET /v1/models 看清单。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# 向量档可以走另一个接入点：中转站通常只转发对话模型，向量得单独接。
# 不填则回落到上面的 OPENAI_*。当前用的是阿里云百炼的
# qwen3.7-text-embedding，传 dimensions=1536 正好对上表结构。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 链尾：前两家都挂了才轮到它。
# 链尾兜底。型号写在 src/lib/llm/config.ts 的 CHAIN。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# 供应商链，按顺序：itokens → 百炼 → DeepSeek。
# 前一家挂了（连不上/超时/5xx/限流）就换后一家重发整条请求。
# 型号写在 src/lib/llm/config.ts 的 CHAIN，不在这里配。
BAILIAN_BASE_URL=https://llm-hyxpesl7lwhsijlo.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=
