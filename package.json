{
  "name": "proofly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm guard:plan && pnpm billing:test && pnpm telemetry:test && pnpm health:test && pnpm arch:test && next build",
    "start": "next start",
    "lint": "eslint",
    "eval:extract": "node --import ./scripts/ts-resolve.mjs --env-file=.env.local scripts/eval-extract.ts",
    "embed:backfill": "node --import ./scripts/ts-resolve.mjs --env-file=.env.local scripts/backfill-embeddings.ts",
    "chat:probe": "node --import ./scripts/ts-resolve.mjs --env-file=.env.local scripts/chat-probe.ts",
    "split:probe": "node --import ./scripts/ts-resolve.mjs --env-file=.env.local scripts/split-probe.ts",
    "locate:probe": "node --import ./scripts/ts-resolve.mjs --env-file=.env.local scripts/locate-probe.ts",
    "ripple:probe": "node --import ./scripts/ts-resolve.mjs scripts/ripple-probe.ts",
    "nudge:probe": "node --import ./scripts/ts-resolve.mjs --env-file=.env.local scripts/nudge-probe.ts",
    "targets:probe": "node --import ./scripts/ts-resolve.mjs scripts/targets-probe.ts",
    "strategy:probe": "node --import ./scripts/ts-resolve.mjs scripts/strategy-probe.ts",
    "jd:probe": "node --import ./scripts/ts-resolve.mjs --env-file=.env.local scripts/jd-probe.ts",
    "scoring:probe": "node --import ./scripts/ts-resolve.mjs scripts/scoring-probe.ts",
    "plan:probe": "node --import ./scripts/ts-resolve.mjs --env-file=.env.local scripts/plan-probe.ts",
    "planning:probe": "node --import ./scripts/ts-resolve.mjs scripts/planning-probe.ts",
    "resume:probe": "node --import ./scripts/ts-resolve.mjs scripts/resume-probe.ts",
    "gate:test": "node --import ./scripts/ts-resolve.mjs --test src/lib/resume/gate.test.ts",
    "interview:probe": "node --import ./scripts/ts-resolve.mjs scripts/interview-probe.ts",
    "health:probe": "node --import ./scripts/ts-resolve.mjs scripts/health-probe.ts",
    "assess:probe": "node --import ./scripts/ts-resolve.mjs --env-file=.env.local scripts/assess-probe.ts",
    "guard:plan": "node --import ./scripts/ts-resolve.mjs --test src/config/plan.guard.test.ts",
    "billing:test": "node --import ./scripts/ts-resolve.mjs --test src/lib/billing/*.test.ts",
    "arch:test": "node --import ./scripts/ts-resolve.mjs --test src/lib/__tests__/arch.test.ts",
    "telemetry:test": "node --import ./scripts/ts-resolve.mjs --test src/lib/telemetry/*.test.ts",
    "health:test": "node --import ./scripts/ts-resolve.mjs --test src/lib/health/*.test.ts",
    "gen-code": "node --import ./scripts/ts-resolve.mjs --env-file=.env.local scripts/gen-code.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "mammoth": "^1.12.1",
    "next": "16.3.2",
    "openai": "^7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
